rules_version = '2';

// Paste this into Firebase console > Firestore Database > Rules, then Publish.
//
// The app holds many associations ("orgs"). Each one's data lives under orgs/{orgId} and is
// kept apart from every other association by these rules.
//
// Who can do what
//   Product owner          = emails with a document in `platformAdmins` (created by hand in the
//                            console; the app can never write it). May list associations and
//                            change an association's plan (trial / active / suspended).
//   Appointments officers  = emails with a document in orgs/{orgId}/admins. The person who
//                            creates an association becomes its first officer; officers can add
//                            and remove other officers of their own association only.
//   Umpires                = any signed-in, email-verified user who opens an association's link:
//                              - read/write their own umpire profile there (cannot approve themselves)
//                              - read/write their own season availability there
//                              - read its season calendar and rounds, and the games of PUBLISHED rounds only
//                                (all of these only once they have a member record there)
//   A suspended association is read-only.
//   Everything else is denied.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function me() {
      return request.auth.token.email.lower();
    }
    function isPlatformAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/platformAdmins/$(me()));
    }
    function isOrgAdmin(orgId) {
      return signedIn() && exists(/databases/$(database)/documents/orgs/$(orgId)/admins/$(me()));
    }
    // Has a member record in this association (approved or still waiting): what lets someone see
    // its rounds and fixtures, and send its officer an alert.
    function isMember(orgId) {
      return signedIn() && exists(/databases/$(database)/documents/orgs/$(orgId)/umpires/$(me()));
    }
    function inOrg(orgId) {
      return isOrgAdmin(orgId) || isMember(orgId);
    }
    function orgData(orgId) {
      return get(/databases/$(database)/documents/orgs/$(orgId)).data;
    }
    // Trial and paid associations can be changed; a suspended one cannot.
    function orgOpen(orgId) {
      return orgData(orgId).plan in ['trial', 'active'];
    }
    // Only these fields may change in an update
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Outgoing email, sent by the "Trigger Email from Firestore" extension (if installed).
    // Write-only, and only to the address the association set in Settings.
    match /mail/{id} {
      allow read, update, delete: if false;
      allow create: if signedIn()
        && inOrg(request.resource.data.orgId)                                   // only that association's people
        && request.resource.data.keys().hasOnly(['to', 'message', 'orgId', 'createdAt'])
        && request.resource.data.to == get(/databases/$(database)/documents/orgs/$(request.resource.data.orgId)).data.notifyEmail;
    }

    // Product owners: you can only check whether YOU are one.
    match /platformAdmins/{id} {
      allow get: if signedIn() && id == me();
      allow list, write: if false;
    }

    // Each person's own list of the associations they have opened (a convenience, gives no access).
    match /users/{id} {
      allow read, write: if signedIn() && id == me();
    }

    // A person's memberships across associations: membership only (association, type, active, since),
    // never another association's availability or appointments. Each association's officers write
    // their own line. An officer may read a member's lines after registering as a viewer, which is
    // only allowed for an officer of an association that person belongs to. The person can read their own.
    match /memberships/{email} {
      match /orgs/{orgId} {
        allow write: if isOrgAdmin(orgId)
          && request.resource.data.keys().hasOnly(['orgId', 'orgName', 'membership', 'active', 'since', 'updatedAt'])
          && request.resource.data.orgId == orgId;
        allow read: if signedIn() && (email == me() || exists(/databases/$(database)/documents/memberships/$(email)/viewers/$(me())));
      }
      match /viewers/{viewer} {
        allow create, update: if signedIn() && viewer == me()
          && request.resource.data.keys().hasOnly(['orgId', 'at'])
          && isOrgAdmin(request.resource.data.orgId)
          && exists(/databases/$(database)/documents/orgs/$(request.resource.data.orgId)/umpires/$(email));
        allow read: if signedIn() && viewer == me();
        allow delete: if false;
      }
    }

    match /orgs/{orgId} {
      // Anyone signed in can open an association by its id (the link); only the product owner can list them all.
      allow get: if signedIn();
      allow list: if isPlatformAdmin();

      // Associations are set up by the product owner, in the console or signed in as a platform admin.
      allow create: if isPlatformAdmin() && request.resource.data.id == orgId;

      // Officers may rename it and set its Play Cricket link, never its plan.
      allow update: if isPlatformAdmin()
        || (isOrgAdmin(orgId) && onlyChanges(['name', 'playCricketId', 'notifyEmail', 'membership', 'playerUmpire', 'updatedAt']));
      allow delete: if false;

      // Officers of this association.
      match /admins/{id} {
        allow get: if signedIn() && (id == me() || isOrgAdmin(orgId));
        allow list: if isOrgAdmin(orgId);
        allow create: if isOrgAdmin(orgId) || isPlatformAdmin();
        allow delete: if isOrgAdmin(orgId) && id != me();                       // you cannot remove yourself, so one officer always remains
        allow update: if false;
      }

      // One document per umpire, id = lower-case email.
      match /umpires/{id} {
        allow get: if signedIn() && (id == me() || isOrgAdmin(orgId));
        allow list: if isOrgAdmin(orgId);

        // Self sign-up: starts inactive until an officer approves.
        allow create: if signedIn() && orgOpen(orgId) && (
          isOrgAdmin(orgId) || (
            id == me()
            && request.resource.data.email == me()
            && request.resource.data.active == false
            && request.resource.data.keys().hasOnly(['pid', 'email', 'name', 'firstName', 'lastName', 'dob', 'address', 'phone', 'accreditation', 'active', 'updatedAt'])
          ));

        // Officers may turn down someone who has just registered.
        allow delete: if isOrgAdmin(orgId) && orgOpen(orgId);

        // Umpires may edit their own details but never `active`, `pid` or `email`.
        allow update: if signedIn() && orgOpen(orgId) && (
          isOrgAdmin(orgId) || (
            id == me()
            && request.resource.data.email == me()
            && onlyChanges(['name', 'firstName', 'lastName', 'dob', 'address', 'phone', 'accreditation', 'updatedAt'])
          ));
      }

      match /rounds/{roundId} {
        allow read: if inOrg(orgId);
        allow write: if isOrgAdmin(orgId) && orgOpen(orgId);

        // Allocations are only visible to umpires once the round is published.
        match /games/{gameId} {
          allow read: if isOrgAdmin(orgId)
            || (isMember(orgId) && get(/databases/$(database)/documents/orgs/$(orgId)/rounds/$(roundId)).data.published == true);
          allow write: if isOrgAdmin(orgId) && orgOpen(orgId);
        }
      }

      // Each round's games with no allocations, so a member can choose games to umpire
      // (player umpire) before a round is published.
      match /fixtures/{roundId} {
        allow read: if inOrg(orgId);
        allow write: if isOrgAdmin(orgId) && orgOpen(orgId);
      }

      // The season calendar (dates umpires answer for). Officers sync it from Play Cricket.
      match /config/{id} {
        allow read: if inOrg(orgId);
        allow write: if isOrgAdmin(orgId) && orgOpen(orgId);
      }

      // One document per umpire per season. id = <seasonId>__<email>
      match /availability/{id} {
        allow get: if signedIn() && (id.split('__')[1] == me() || isOrgAdmin(orgId));
        allow list: if isOrgAdmin(orgId);
        allow create, update: if signedIn() && orgOpen(orgId) && (
          isOrgAdmin(orgId) || (
            id.split('__')[1] == me()
            && request.resource.data.email == me()
            && request.resource.data.seasonId == id.split('__')[0]
          ));
      }

      // An umpire who turns an answer to "Not available" after a round is published records it here;
      // the officer's app frees the slot and marks it handled.
      match /withdrawals/{id} {
        allow get, list: if isOrgAdmin(orgId);
        // Only for yourself: the email AND the umpire id must be your own member record's.
        allow create: if isMember(orgId) && orgOpen(orgId)
          && request.resource.data.email == me()
          && request.resource.data.pid == get(/databases/$(database)/documents/orgs/$(orgId)/umpires/$(me())).data.pid
          && request.resource.data.handled == false;
        allow update, delete: if isOrgAdmin(orgId) && orgOpen(orgId);
      }

      match /settings/{id} {
        allow read, write: if isOrgAdmin(orgId);
      }
    }
  }
}
